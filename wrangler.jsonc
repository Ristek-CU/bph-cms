{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sga-superapp-bph-cms",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-05",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"keep_vars": true,
	"vars": {
		"API_BASE_URL": "http://localhost:8791/api/v1",
		"CORS_ORIGIN": "http://localhost:5173,https://sga-cakrawala.org,https://cms.sga-cakrawala.org"
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "bph-cms-media"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bph-cms-db",
			"database_id": "5cdcc09b-5688-4ce4-9bbe-8f9d65c8dfc0",
			"migrations_dir": "drizzle",
			"remote": true
		}
	],
	"services": [
		{
			"binding": "AUTH_SERVICE",
			"service": "sga-superapp-auth"
		}
	],
	"dev": {
		"inspector_port": 9236
	}
}
