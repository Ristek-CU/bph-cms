/index.html
  Cache-Control: no-cache, no-store, must-revalidate, no-transform

/
  Cache-Control: no-cache, no-store, must-revalidate, no-transform

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  # Cloudflare JavaScript Detections menyisipkan inline script yang berubah tiap
  # request. HTML root memakai no-transform agar CSP tetap menolak inline script.
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://cms.sga-cakrawala.org https://bph-cms.sga-cakrawala.org https://cloudflareinsights.com; img-src 'self' data: blob: https://cms.sga-cakrawala.org https://bph-cms.sga-cakrawala.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' https://static.cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
