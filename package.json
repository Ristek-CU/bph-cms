{
	"name": "bph-cms",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --port 8791",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply bph-cms-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply bph-cms-db --remote",
		"test": "tsx src/modules/events/status.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hono-rate-limiter/cloudflare": "^0.2.2",
		"@hono/standard-validator": "^0.2.2",
		"@scalar/hono-api-reference": "^0.10.16",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.1",
		"hono-openapi": "^1.3.0",
		"uuidv7": "^1.2.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260804.1",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"wrangler": "^4.120.0"
	}
}
